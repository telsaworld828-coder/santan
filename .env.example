# Supabase Configuration
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Admin Console Credentials
# Used for the admin dashboard login (default values for local dev)
VITE_ADMIN_EMAIL=admin@santander.app
VITE_ADMIN_PASSWORD=admin1234
VITE_ADMIN_PIN=1234

# ────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
# ────────────────────────────────────────────────────────────
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. For local development (offline mode):
#    - Leave VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY empty
#    - App will use localStorage only
#
# 3. To connect to Supabase:
#    a) Create a Supabase project at https://supabase.com
#    b) Run the schema: cat supabase-schema.sql | paste into SQL Editor
#    c) Enable Realtime for santander_users and santander_transactions
#    d) Copy your Project URL and Anon Key from Settings → API
#    e) Paste them below
#
# 4. For Vercel deployment:
#    - Add all 5 variables in Vercel Project Settings → Environment Variables
#    - Use same values as .env.local
# ────────────────────────────────────────────────────────────
